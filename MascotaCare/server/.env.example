# ============================================================================
# MascotaCare - Variables de entorno del servidor API
# ----------------------------------------------------------------------------
# NOTA: Este archivo contiene la contraseña de la base de datos y por eso está
# excluido del control de versiones (.gitignore). Copia este archivo a
# "server/.env" y ajusta los valores a tu entorno local.
#
# Datos de conexión a PostgreSQL (usuario por defecto "postgres").
# ============================================================================
# Puerto del servidor Express.
PORT=4000

# Cadena de conexión PostgreSQL. Usuario por defecto y contraseña de tu entorno.
DATABASE_URL=postgres://postgres:tucontrasena@localhost:5432/MascotaCare

# Secreto aleatorio para firmar los JSON Web Tokens (mínimo 32 caracteres).
# Genera uno propio, por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=reemplaza_este_valor_por_un_secreto_aleatorio_de_32_caracteres

# Tiempo de expiración del token.
JWT_EXPIRES_IN=7d

# Orígenes web autorizados, separados por comas. Las apps nativas no requieren
# esta lista; para Expo web agrega el host y puerto que estés usando.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
